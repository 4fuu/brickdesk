#!/usr/bin/env bash
# Prepares an Amp orb to build and test brickdesk on the host
# (SDL2 + Mesa GLES2, headless screenshot tests). Mirrors .github/workflows/ci.yml.
set -euo pipefail

step() { printf '\n== %s (%s)\n' "$1" "$(date +%T)"; }

SUDO=""
if [ "$(id -u)" -ne 0 ]; then SUDO="sudo"; fi

packages=(
  build-essential cmake ninja-build pkg-config
  libsdl2-dev libegl1-mesa-dev libgles2-mesa-dev libgl1-mesa-dri
  python3 python3-pil python3-numpy
  xvfb xdotool shellcheck file
)

step "Checking system packages"
missing=()
for p in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed'; then
    missing+=("$p")
  fi
done

if [ "${#missing[@]}" -gt 0 ]; then
  step "Installing: ${missing[*]}"
  $SUDO apt-get update -qq
  DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y -qq --no-install-recommends "${missing[@]}"
else
  echo "all packages present"
fi

# CMake's FindPython3 picks the first python3 on PATH, which in orbs is
# /usr/local/bin/python3 and does not see the apt python3-* modules.
step "Checking Python test modules"
if ! python3 -c 'import PIL, numpy' 2>/dev/null; then
  python3 -m pip install -q --disable-pip-version-check numpy pillow
fi
python3 -c 'import PIL, numpy; print("python3:", PIL.__version__, numpy.__version__)'

step "Building host tree"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -f "$repo_root/CMakeLists.txt" ]; then
  BRICKDESK_WERROR=ON "$repo_root/scripts/build-host.sh"
fi

step "Done"
