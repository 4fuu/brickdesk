# Build trees
/build/
/build-*/
/cmake-build-*/

# Editor and OS noise
.DS_Store
*.swp
*.swo
*~

# Local tooling / agent state
/.amp/
/.cache/
/compile_commands.json

# Test output that is not checked in
/tests/artifacts/

# Python bytecode
__pycache__/
*.py[cod]

# Built sample plugin binary (CMake writes it next to plugin.json)
/plugins/hello/bin/

# User configuration written by brickdesk-config
/config/local.ini
/config/local.ini.*

# runtime battery samples when running a host build against config/
config/battery-history.csv
