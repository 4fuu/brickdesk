diff --git a/src/video/mali-fbdev/SDL_malivideo.c b/src/video/mali-fbdev/SDL_malivideo.c
index 953e6d3..f641438 100644
--- a/src/video/mali-fbdev/SDL_malivideo.c
+++ b/src/video/mali-fbdev/SDL_malivideo.c
@@ -105,6 +105,7 @@ MALI_VideoInit(_THIS)
     }
 
     if (ioctl(fd, FBIOGET_VSCREENINFO, &vinfo) < 0) {
+        close(fd);
         MALI_VideoQuit(_this);
         return SDL_SetError("mali-fbdev: Could not get framebuffer information");
     }
@@ -118,9 +119,10 @@ MALI_VideoInit(_THIS)
     close(fd);
     system("setterm -cursor off");
 
-#if 0 //TRIMUI for PowerVR GE8300
-    data->native_display.width = vinfo.xres;
-    data->native_display.height = vinfo.yres;
+#ifdef SDL2_POWERVR_GE8300
+    /* Brick Pro reports 1024x768 here; the Smart Pro SDK hardcoded 1280x720. */
+    data->native_display.width = (unsigned short) vinfo.xres;
+    data->native_display.height = (unsigned short) vinfo.yres;
 #endif
 
     SDL_zero(current_mode);
@@ -193,14 +195,9 @@ MALI_CreateWindow(_THIS, SDL_Window * window)
         return SDL_OutOfMemory();
     }
 
-#ifndef SDL2_POWERVR_GE8300
-    /* Windows have one size for now */
