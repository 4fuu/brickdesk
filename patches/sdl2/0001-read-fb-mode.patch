     window->w = displaydata->native_display.width;
     window->h = displaydata->native_display.height;
-#else
-    window->w = 1280;
-    window->h = 720;
-#endif
 
     /* OpenGL ES is the law here */
     window->flags |= SDL_WINDOW_OPENGL;
@@ -211,11 +208,7 @@ MALI_CreateWindow(_THIS, SDL_Window * window)
         }
     }
     
-#ifndef SDL2_POWERVR_GE8300
     windowdata->egl_surface = SDL_EGL_CreateSurface(_this, (NativeWindowType) &displaydata->native_display);
-#else
-    windowdata->egl_surface = SDL_EGL_CreateSurface(_this, (NativeWindowType) displaydata->native_display);
-#endif
 
 
     if (windowdata->egl_surface == EGL_NO_SURFACE) {
diff --git a/src/video/mali-fbdev/SDL_malivideo.h b/src/video/mali-fbdev/SDL_malivideo.h
index 4ee0788..eb941aa 100644
--- a/src/video/mali-fbdev/SDL_malivideo.h
+++ b/src/video/mali-fbdev/SDL_malivideo.h
@@ -18,10 +18,21 @@
 
 #define SDL2_POWERVR_GE8300     1      //TRIMUI for PowerVR GE8300
 
+#ifdef SDL2_POWERVR_GE8300
+/* The SDK declares EGLNativeWindowType as void*, but the PowerVR NULL WSEGL
+ * expects a pointer to a fbdev_window describing the surface size. Keep the
+ * framebuffer mode in this struct and pass its address to eglCreateWindowSurface(). */
+struct fbdev_window
+{
+    unsigned short width;
+    unsigned short height;
+};
+#endif
+
 typedef struct SDL_DisplayData
 {
 #ifdef SDL2_POWERVR_GE8300
-    EGLNativeWindowType native_display;
+    struct fbdev_window native_display;
 #else
     struct fbdev_window native_display;
 #endif
