{
  "schema": 1,
  "id": "com.brickdesk.hello-py",
  "name": "Hello Python",
  "version": "0.1.0",
  "api": 1,
  "runtime": "python",
  "entry": ["main.py", "--socket", "{socket}"],
  "capabilities": ["tile", "settings"],
  "permissions": [],
  "tile": { "w": 1, "h": 1, "refresh_hz": 15 },
  "limits": { "memory_mb": 128, "nofile": 32 },
  "settings": [
    { "key": "show_meta", "type": "bool", "label": "Show meta", "default": true },
    { "key": "pace", "type": "int", "label": "Pace", "default": 3 },
    { "key": "mode", "type": "string", "label": "Mode", "default": "calm" }
  ]
}
